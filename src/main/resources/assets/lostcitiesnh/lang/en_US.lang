# Lost Cities: New Horizons, English (US). The source of truth for every player-visible string.

# Commands
lostcitiesnh.command.usage=/lostcities <subcommand>. Subcommands: profile, timers, test, view, find
lostcitiesnh.command.unknown=Unknown subcommand: %s
lostcitiesnh.command.no_permission=You do not have permission to use this subcommand.
lostcitiesnh.command.test.usage=/lostcities test <scenario|prefix|all|list>
lostcitiesnh.command.test.disabled=Scenarios run only in the development environment, or with -Dlostcitiesnh.testHooks=true.
lostcitiesnh.command.test.no_match=No scenario matches '%s'. Try /lostcities test list.
lostcitiesnh.command.test.busy=A scenario run is already in progress.
lostcitiesnh.command.test.list=Scenarios: %s
lostcitiesnh.command.test.started=Running %s scenario(s); results follow.
lostcitiesnh.command.profile.usage=/lostcities profile [pin <profile> confirm]
lostcitiesnh.command.profile.none=Dimension %s has no pinned profile, so no cities generate there.
lostcitiesnh.command.profile.show=Dimension %s: %s
lostcitiesnh.command.profile.unknown=Unknown profile '%s'. Known profiles: %s
lostcitiesnh.command.profile.confirm=Pinning %s changes what new chunks of dimension %s generate, and chunks generated before will not match them. Add 'confirm' to pin it.
lostcitiesnh.command.profile.pinned=Pinned profile %s into dimension %s.
lostcitiesnh.command.profile.unsupported=Dimension %s cannot have cities: world type %s has no height oracle.
lostcitiesnh.command.timers.usage=/lostcities timers [reset]
lostcitiesnh.command.timers.none=Cities are not generating in dimension %s.
lostcitiesnh.command.timers.line=%s
lostcitiesnh.command.timers.reset=Generation timers of dimension %s reset.
lostcitiesnh.command.view.usage=/lostcities view <player> <x> <y> <z> <yaw> <pitch>
lostcitiesnh.command.view.done=Moved %s to %s %s %s.
lostcitiesnh.command.find.usage=/lostcities find <center|street|interior|edge|softedge|reserved|village> [radius in chunks] [best]
lostcitiesnh.command.find.no_cities=Dimension %s has no real cities to search.
lostcitiesnh.command.find.none=No %s within %s chunks.
lostcitiesnh.command.find.found=%s at %s %s %s (%s); view from %s %s %s, yaw %s, pitch %s.

# Scenario harness
lostcitiesnh.scenario.result=%s %s (%s ms): %s
lostcitiesnh.scenario.summary=Scenarios: %s passed, %s failed

